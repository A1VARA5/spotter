# PayPal sandbox app (developer.paypal.com > Apps & Credentials). Sandbox only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PayPal webhook id (scripts/register-paypal-webhook.mts prints it). Without it /api/paypal/webhook refuses everything.
PAYPAL_WEBHOOK_ID=
# Log in with PayPal return URL, also set in the PayPal app settings
PAYPAL_LOGIN_REDIRECT_URI=http://localhost:3417/api/auth/paypal/callback

# Claude, for the scam check and reading requests out of emails
ANTHROPIC_API_KEY=
# Optional: a second Anthropic key, used when the first is out of credit, rejected, rate limited or overloaded
ANTHROPIC_API_KEY_BACKUP=
# Optional: last resort for the scam check only (verdict and quoted evidence), when no Anthropic key can answer
OPENAI_API_KEY=

# Signs session cookies. Any random string, 32+ characters.
SESSION_SECRET=

# Postgres (Neon) in production. Leave empty locally to use PGlite in .data/
DATABASE_URL=

# Optional: real retailer prices
CHANNEL3_API_KEY=
# Optional: price watch. The signing secret (whsec_...) of the webhook endpoint you add in Channel3's dashboard
# for https://<your site>/api/channel3/webhook. Without it, deliveries are still only hints and the daily job polls.
CHANNEL3_WEBHOOK_SECRET=
# Optional caps (Channel3 charges 1 credit per tracked product per day). Defaults: 5, 100, 40.
PRICE_WATCHES_PER_FAMILY=
PRICE_WATCHES_ACTIVE=
PRICE_WATCHES_PER_DAY=

# Optional: KERNEL cloud browsers, so the case agent can open a suspicious link without anyone clicking it
KERNEL_API_KEY=

# Optional: the email channel (Agentboxd inbox and its webhook secret)
AGENTBOXD_API_KEY=
AGENTBOXD_INBOX_ID=
AGENTBOXD_INBOX_ADDRESS=
AGENTBOXD_WEBHOOK_SECRET=

# Public URL used in alert emails
NEXT_PUBLIC_SITE_URL=http://localhost:3417

# Daily cap on checks, to protect the API budget
SPOTTER_DAILY_LIMIT=150
# Watchtower (AG Studio). Works without a key on localhost; deployed sites show a watermark without one.
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=
# Optional daily caps on Watchtower's assistant (defaults 60 per family, 600 overall)
WATCHTOWER_TURNS_PER_FAMILY=
WATCHTOWER_TURNS_PER_DAY=
# Daily reconcile job (Vercel cron sends it as a Bearer token)
CRON_SECRET=
